# Copy this file to .env.local (ignored by git) and fill in the values.
# This file lists NAMES only. Never put a real value in it.
# Which values to use for each environment: docs/backend/environments.md

# Public — inlined into the JavaScript sent to every browser.
# Dashboard → Settings → API Keys (or the output of `npx supabase start`).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SECRET — server only. Bypasses row level security. Never prefix it with
# NEXT_PUBLIC_, never commit it, never log it. Leave it empty: no Phase 2 code
# needs it (see docs/backend/security-foundations.md).
SUPABASE_SECRET_KEY=

# Optional, server only: "azure" or "google" shows "Continuer avec ton compte de
# l'école" on /login. Leave empty until the school's identity provider is
# configured in Supabase (docs/backend/authentication.md).
AUTH_SSO_PROVIDER=

# Development only, server only: "on" shows the dashed "Comptes de test" form on
# /login for the fictional @comptes.example.test accounts. NEVER set it in
# production (docs/backend/authentication.md, Test accounts).
AUTH_TEST_ACCOUNTS=

# Server only: the site's public address, e.g. https://<domain of the BDE>.
# Used for absolute links (Open Graph, canonical, sitemap). Leave empty until
# the BDE has bought its domain: nothing guesses it (src/lib/site-url.ts).
SITE_URL=
